+    namespace
+    {
+        // MXL extension (bobi.studio) : pour "video/x-mxl-planar", nombre de slices par grain.
+        // Le flowDef peut porter un champ optionnel "slice_height" (lignes par bande) : le grain
+        // est alors publie en N = hauteur_grain / slice_height tranches de taille egale (commit
+        // progressif validSlices=1..N pour la latence sous-trame). Absent ou <= 0 -> 1 slice
+        // (trame pleine, comportement historique du patch planar).
+        std::size_t planarSliceCount(picojson::object const& root, bool interlaced)
+        {
+            auto const it = root.find("slice_height");
+            if (it == root.end() || !it->second.is<double>())
+            {
+                return 1U;
+            }
+            auto const sliceHeight = static_cast<long long>(it->second.get<double>());
+            if (sliceHeight <= 0)
+            {
+                return 1U;
+            }
+            auto height = static_cast<std::size_t>(fetchAs<double>(root, "frame_height"));
+            if (interlaced)
+            {
+                height /= 2U; // grain = un champ
+            }
+            if ((height % static_cast<std::size_t>(sliceHeight)) != 0U)
+            {
+                auto msg = fmt::format("slice_height {} does not divide grain height {}", sliceHeight, height);
+                throw std::invalid_argument{std::move(msg)};
+            }
+            return height / static_cast<std::size_t>(sliceHeight);
+        }
+    }
